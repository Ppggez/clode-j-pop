# Ignore node modules (ติดตั้งใหม่ใน image)
node_modules

# Ignore build output (build ใหม่ใน image)
dist

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local env files / secrets
.env
.env.local
